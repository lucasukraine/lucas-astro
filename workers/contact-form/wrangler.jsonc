{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contact-form",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  // Rate limiting binding — 5 запитів/60с на ключ (ми використовуємо IP як ключ).
  // namespace_id — довільний локальний ідентифікатор біндингу, не потребує
  // окремого створення ресурсу (на відміну від KV/D1).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
