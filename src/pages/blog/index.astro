---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getAllPosts } from '../../lib/blog';
const posts = getAllPosts();

// Порядок відповідає порядку послуг на головній (Аудит → SAF-T → ERP → ТЦУ).
// Джерело істини для тегів — категорії в blogPosts.ts; тут лише фіксований
// порядок показу фільтрів, а не перелік дозволених значень.
const categoryOrder = ['Аудит та звітність', 'Е-аудит та SAF-T', 'ERP та облік', 'Трансфертне ціноутворення'];
const categories = categoryOrder.filter(cat => posts.some(p => p.category === cat));
---

<BaseLayout
  title="Блог — експертні матеріали з аудиту, МСФЗ, SAF-T та ERP | LUCAS"
  description="Гайди та аналітика для CFO і головних бухгалтерів: аудит, МСФЗ, SAF-T, трансфертне ціноутворення та перехід з 1С на Odoo ERP в Україні."
>
  <main>

    <section class="blog-hero">
      <div class="blog-hero-deco" aria-hidden="true"></div>
      <div class="blog-hero-inner">
        <div class="art-eyebrow">База знань</div>
        <h1 class="blog-hero-h1">Експертні матеріали<span class="op">.</span></h1>
        <p class="blog-hero-lead">Гайди, аналітика та практичні відповіді на питання, з якими стикаються фінансові директори і головні бухгалтери у 2026 році. Аудит, МСФЗ, SAF-T, трансфертне ціноутворення, перехід на Odoo.</p>
      </div>
    </section>

    <section class="blog-list">
      <div class="blog-list-inner">
        <div class="blog-filters" role="group" aria-label="Фільтр за темою">
          <button class="blog-filter is-active" type="button" data-filter="all">Усі</button>
          {categories.map(cat => (
            <button class="blog-filter" type="button" data-filter={cat}>{cat}</button>
          ))}
        </div>
        <div class="blog-grid" id="blog-grid">
          {posts.map(post => (
            <BlogCard
              category={post.category}
              readingTime={post.readingTime}
              cardTitle={post.cardTitle}
              excerpt={post.excerpt}
              date={post.date}
              href={post.href}
            />
          ))}
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const filters = document.querySelectorAll('.blog-filter');
    const cards = document.querySelectorAll('#blog-grid .blog-card');
    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        filters.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const filter = btn.dataset.filter;
        cards.forEach(card => {
          const show = filter === 'all' || card.dataset.category === filter;
          card.style.display = show ? '' : 'none';
        });
      });
    });
  })();
</script>
